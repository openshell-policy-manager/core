{
  "model_profile": "inherit",
  "commit_docs": true,
  "parallelization": false,
  "search_gitignored": false,
  "brave_search": false,
  "firecrawl": false,
  "exa_search": false,
  "git": {
    "branching_strategy": "none",
    "phase_branch_template": "gsd/phase-{phase}-{slug}",
    "milestone_branch_template": "gsd/{milestone}-{slug}",
    "quick_branch_template": null
  },
  "workflow": {
    "research": true,
    "plan_check": true,
    "verifier": true,
    "nyquist_validation": true,
    "auto_advance": true,
    "node_repair": true,
    "node_repair_budget": 2,
    "ui_phase": true,
    "ui_safety_gate": true,
    "text_mode": false,
    "research_before_questions": false,
    "discuss_mode": "discuss",
    "skip_discuss": false,
    "_auto_chain_active": false
  },
  "hooks": {
    "context_warnings": true
  },
  "project_code": null,
  "phase_naming": "sequential",
  "agent_skills": {
    "websearch": {
      "enabled": true,
      "permissions": ["network"],
      "description": "Web-Recherche für Exa-Search und Live-Crawling"
    },
    "webfetch": {
      "enabled": true,
      "permissions": ["network"],
      "description": "Web-Content laden von spezifischen URLs"
    },
    "codesearch": {
      "enabled": true,
      "permissions": ["read"],
      "description": "Code-Analyse via Exa Code API"
    },
    "file_operations": {
      "enabled": true,
      "permissions": ["read", "write", "glob", "grep"],
      "description": "Dateizugriffe für Projektdateien"
    },
    "git_operations": {
      "enabled": true,
      "permissions": ["status", "diff", "commit", "push", "pull"],
      "description": "Git-Repository-Interaktionen"
    }
  },
  "resolve_model_ids": "omit",
  "mode": "yolo",
  "granularity": "standard"
}